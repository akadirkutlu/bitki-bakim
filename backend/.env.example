PORT=4000
JWT_SECRET=change-me-in-production

# Comma-separated Google OAuth client IDs (Web, iOS, Android)
GOOGLE_CLIENT_IDS=

# Apple Sign In audiences (comma-separated bundle IDs)
# Production/dev build: com.bitkibakim.app
# Expo Go on iOS: host.exp.Exponent
APPLE_CLIENT_IDS=com.bitkibakim.app,host.exp.Exponent

# Pl@ntNet API key for photo identification (https://my.plantnet.org/) — free tier: 500/day
PLANTNET_API_KEY=
