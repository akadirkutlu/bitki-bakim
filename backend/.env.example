PORT=4000
JWT_SECRET=change-me-in-production

# MongoDB connection string for persistent storage (Northflank / MongoDB Atlas).
# When unset, the backend falls back to local JSON files (dev only — NOT persistent in the cloud).
MONGODB_URI=
MONGODB_DB=bitkibakim

# Comma-separated Google OAuth client IDs (Web, iOS, Android)
GOOGLE_CLIENT_IDS=

# Apple Sign In audiences (comma-separated bundle IDs)
# Production/dev build: com.bitkibakim.app
# Expo Go on iOS: host.exp.Exponent
APPLE_CLIENT_IDS=com.bitkibakim.app,host.exp.Exponent

# Pl@ntNet API key for photo identification (https://my.plantnet.org/) — free tier: 500/day
PLANTNET_API_KEY=

# Apple In-App Purchase / App Store Server API
APPLE_BUNDLE_ID=com.bitkibakim.app
APPLE_APP_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_ENVIRONMENT=Sandbox
APPLE_PREMIUM_PRODUCT_IDS=com.bitkibakim.app.premium.monthly
